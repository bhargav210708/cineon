# Local Vite development only. This VITE_ token is bundled into the browser build.
# Do not use VITE_TMDB_TOKEN for a public production deployment.
VITE_TMDB_TOKEN=your_tmdb_read_access_token

# Vercel production: configure this in Project Settings > Environment Variables.
# Leave it server-only (no VITE_ prefix).
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
